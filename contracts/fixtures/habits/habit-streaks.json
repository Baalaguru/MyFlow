{
  "rule": "habit.streaks",
  "cases": [
    {
      "case": "skipped and rest days do not break streak, missed scheduled day does",
      "input": {
        "today": "2026-11-06",
        "habit": {
          "id": "h1",
          "createdAt": "2026-11-01T00:00:00.000Z",
          "paused": false,
          "archived": false,
          "schedule": { "type": "daily", "weekdays": [0,1,2,3,4,5,6] }
        },
        "logs": [
          { "habitId": "h1", "localDate": "2026-11-01", "status": "done" },
          { "habitId": "h1", "localDate": "2026-11-02", "status": "skipped" },
          { "habitId": "h1", "localDate": "2026-11-03", "status": "rest" },
          { "habitId": "h1", "localDate": "2026-11-04", "status": "done" },
          { "habitId": "h1", "localDate": "2026-11-06", "status": "done" }
        ]
      },
      "expected": { "currentStreak": 1, "longestStreak": 2 }
    },
    {
      "case": "schedule changes recompute from history",
      "input": {
        "today": "2026-11-04",
        "habit": {
          "id": "h1",
          "createdAt": "2026-11-01T00:00:00.000Z",
          "paused": false,
          "archived": false,
          "schedule": { "type": "weekdays", "weekdays": [1,3,5] }
        },
        "logs": [
          { "habitId": "h1", "localDate": "2026-11-02", "status": "done" },
          { "habitId": "h1", "localDate": "2026-11-03", "status": "done" },
          { "habitId": "h1", "localDate": "2026-11-04", "status": "done" }
        ]
      },
      "expected": { "currentStreak": 2, "longestStreak": 2 }
    }
  ]
}