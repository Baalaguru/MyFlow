{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MyFlow design tokens",
  "version": "1.0.0",
  "colors": {
    "primitives": {
      "parchment": "#F3EBDD",
      "paper": "#E4D7C1",
      "leather": "#70563B",
      "sage": "#788064",
      "terracotta": "#A36F59",
      "ink": "#3B332B"
    },
    "light": {
      "background": "#F3EBDD",
      "surface": "#E4D7C1",
      "primary": "#70563B",
      "growth": "#788064",
      "highlight": "#A36F59",
      "text": "#3B332B",
      "onPrimary": "#FBF5E9"
    },
    "dark": {
      "background": "#241E1A",
      "surface": "#302821",
      "primary": "#A98A6B",
      "growth": "#98A282",
      "highlight": "#C08B72",
      "text": "#F0E4D0",
      "onPrimary": "#241E1A"
    }
  },
  "typography": {
    "display": ["Cormorant Garamond", "Georgia", "serif"],
    "heading": ["Libre Baskerville", "Georgia", "serif"],
    "section": ["Lora", "Georgia", "serif"],
    "body": ["Nunito Sans", "Segoe UI", "sans-serif"]
  },
  "spacing": { "unit": 4, "scale": [0, 1, 2, 3, 4, 6, 8, 12, 16] },
  "radii": { "sm": 4, "md": 8, "lg": 12, "pill": 999 },
  "motion": { "fast": 120, "normal": 220, "slow": 360 }
}
