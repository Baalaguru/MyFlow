{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myflow.local/contracts/schemas/meal-entry.schema.json",
  "title": "MealEntry",
  "description": "A consumed food or recipe entry. Quantity is measured in servings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "localDate", "mealType", "quantity", "loggedAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "localDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "mealType": { "type": "string", "enum": ["breakfast", "lunch", "dinner", "snack"] },
    "foodId": { "type": ["string", "null"] },
    "recipeId": { "type": ["string", "null"] },
    "quantity": { "type": "number", "exclusiveMinimum": 0 },
    "notes": { "type": ["string", "null"] },
    "imageRef": { "type": ["string", "null"] },
    "loggedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    { "anyOf": [{ "required": ["foodId"] }, { "required": ["recipeId"] }] },
    { "not": { "required": ["foodId", "recipeId"] } }
  ]
}
