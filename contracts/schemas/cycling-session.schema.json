{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myflow.local/contracts/schemas/cycling-session.schema.json",
  "title": "CyclingSession",
  "description": "Local cycling ride with derived speed and distance only; route points are deferred.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "localDate", "startedAt", "endedAt", "durationSeconds", "movingSeconds", "pauseSeconds", "stationarySeconds", "distanceMeters", "averageSpeedKmh", "maxSpeedKmh", "sourceQuality", "notes", "createdAt", "updatedAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "localDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "durationSeconds": { "type": "number", "minimum": 0 },
    "movingSeconds": { "type": "number", "minimum": 0 },
    "pauseSeconds": { "type": "number", "minimum": 0 },
    "stationarySeconds": { "type": "number", "minimum": 0 },
    "distanceMeters": { "type": ["number", "null"], "minimum": 0 },
    "averageSpeedKmh": { "type": ["number", "null"], "minimum": 0 },
    "maxSpeedKmh": { "type": ["number", "null"], "minimum": 0 },
    "sourceQuality": { "type": "string", "enum": ["manual", "gps_accepted", "gps_filtered", "unavailable"] },
    "notes": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
