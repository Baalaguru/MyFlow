{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myflow.local/schemas/entity-base.schema.json",
  "title": "Synchronizable entity metadata",
  "type": "object",
  "required": ["id", "revision", "hlc_created", "hlc_updated"],
  "properties": {
    "id": { "type": "string", "format": "uuid", "description": "Client-generated UUIDv7; stable across sync" },
    "revision": { "type": "integer", "minimum": 1 },
    "hlc_created": { "type": "string", "pattern": "^[0-9]+-[0-9]+-[A-Za-z0-9_-]+$" },
    "hlc_updated": { "type": "string", "pattern": "^[0-9]+-[0-9]+-[A-Za-z0-9_-]+$" },
    "hlc_deleted": { "type": ["string", "null"], "pattern": "^[0-9]+-[0-9]+-[A-Za-z0-9_-]+$" },
    "base_revision": { "type": ["integer", "null"] },
    "base_payload": { "type": ["object", "null"] }
  },
  "additionalProperties": true
}
