{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myflow.local/contracts/schemas/cycling-location-point.schema.json",
  "title": "CyclingLocationPoint",
  "description": "Contract-only GPS candidate point. Defined for filtering rules but not written in v1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionId", "recordedAt", "latitude", "longitude", "accuracyMeters", "speedKmh", "filtered"],
  "properties": {
    "sessionId": { "type": "string", "minLength": 1 },
    "recordedAt": { "type": "string", "format": "date-time" },
    "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
    "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
    "accuracyMeters": { "type": "number", "minimum": 0 },
    "speedKmh": { "type": "number", "minimum": 0 },
    "filtered": { "type": "boolean" }
  }
}
