{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myflow.local/contracts/schemas/recipe.schema.json",
  "title": "Recipe",
  "description": "Canonical recipe with owned ingredient and step arrays. Nutrition per serving is derived, never stored.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "servings", "prepMinutes", "cookMinutes", "favorite", "ingredients", "steps", "createdAt", "updatedAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "servings": { "type": "integer", "minimum": 1 },
    "prepMinutes": { "type": "integer", "minimum": 0 },
    "cookMinutes": { "type": "integer", "minimum": 0 },
    "favorite": { "type": "boolean" },
    "notes": { "type": ["string", "null"] },
    "imageRef": { "type": ["string", "null"] },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "recipeId", "foodId", "quantity"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "recipeId": { "type": "string", "minLength": 1 },
          "foodId": { "type": "string", "minLength": 1 },
          "quantity": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "recipeId", "order", "text"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "recipeId": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
