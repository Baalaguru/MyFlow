{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myflow.local/contracts/schemas/nutrition-goal.schema.json",
  "title": "NutritionGoal",
  "description": "Per-local-date nutrition targets. A missing or zero goal is unavailable, not a zero-value chart.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "localDate", "calories", "protein", "carbs", "fat", "updatedAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "localDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "calories": { "type": "number", "minimum": 0 },
    "protein": { "type": "number", "minimum": 0 },
    "carbs": { "type": "number", "minimum": 0 },
    "fat": { "type": "number", "minimum": 0 },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
