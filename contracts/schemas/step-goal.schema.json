{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myflow.local/contracts/schemas/step-goal.schema.json",
  "title": "StepGoal",
  "description": "Per-local-date step goal; a missing record means progress is unavailable, not zero.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "localDate", "stepGoal", "updatedAt"],
  "properties": {
    "id": { "type": "string", "pattern": "^goal:\\d{4}-\\d{2}-\\d{2}$" },
    "localDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "stepGoal": { "type": "integer", "minimum": 0 },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
