{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myflow.local/contracts/schemas/walking-session.schema.json",
  "title": "WalkingSession",
  "description": "Local walking session. Distance, calories, weight and notes are explicit nulls when unknown.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "localDate", "startedAt", "endedAt", "stepCount", "durationSeconds", "distanceMeters", "calories", "bodyWeightKg", "calorieBasis", "source", "notes", "createdAt", "updatedAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "localDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "stepCount": { "type": "integer", "minimum": 0 },
    "durationSeconds": { "type": "number", "minimum": 0 },
    "distanceMeters": { "type": ["number", "null"], "minimum": 0 },
    "calories": { "type": ["number", "null"], "minimum": 0 },
    "bodyWeightKg": { "type": ["number", "null"], "minimum": 0 },
    "calorieBasis": { "type": "string", "enum": ["manual", "metWalking", "unavailable"] },
    "source": { "type": "string", "enum": ["manual", "sensor"] },
    "notes": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
